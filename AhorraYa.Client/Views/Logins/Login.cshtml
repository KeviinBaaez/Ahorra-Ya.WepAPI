@model UserEditVm

<div class="container d-flex justify-content-center align-items-center mt-5 row">
    <form asp-action="Login" asp-controller="Logins" method="post" class="w-100 col-12" style="max-width:400px;">

        <h1 class="text-center mt-5 mb-5">
            <b>AHORRA YA</b>
        </h1>

        <!-- Email -->
        <div class="form-outline mb-4">
            <input type="text" class="form-control" asp-for="UserName" />
            <label class="form-label" for="email">Enter Email address or UserName</label>
        </div>

        <!-- Password -->
        <div class="form-outline mb-4">
            <input type="password" id="password" class="form-control" asp-for="Password" />
            <label class="form-label" for="password">Password</label>
        </div>

        <!-- Remember + Forgot -->
        <div class="row mb-4">
            <div class="col d-flex justify-content-start">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="remember" checked />
                    <label class="form-check-label" for="remember">
                        Remember me
                    </label>
                </div>
            </div>

            <div class="col text-end">
                <a href="#!">Forgot password?</a>
            </div>
        </div>

        <!-- Button -->
        <button type="submit" class="btn btn-primary w-100 mb-5">
            Sign in
        </button>


    </form>

    <div class="card shadow border-0 mt-5 col-12">
        <div class="card-header bg-primary text-dark">
            <h5 class="mb-0"><i class="fas fa-key"></i> Configuración de Acceso</h5>
        </div>
        <div class="card-body bg-light">
            <p class="mb-2">Para el funcionamiento de los módulos, se debe iniciar sesión con las siguientes credenciales:</p>
            <table class="table table-sm table-bordered bg-white">
                <thead>
                    <tr class="table-secondary">
                        <th>Usuario</th>
                        <th>Password</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>Admin</code></td>
                        <td><code>Adm1n!</code></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>