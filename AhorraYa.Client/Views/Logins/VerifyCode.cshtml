@* Archivo: AhorraYa.WebClient / Views / Logins / VerifyCode.cshtml *@

@{
    ViewData["Title"] = "Verificar Cuenta";
    Layout = "_Layout"; // O el nombre de tu Layout principal si usás uno limpio
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0 rounded-3">
                <div class="card-body p-5">

                    <div class="text-center mb-4">
                        <div class="display-4 text-primary mb-2">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <h2 class="fw-bold text-dark">Confirmá tu cuenta</h2>
                        <p class="text-muted small">Te enviamos un código de verificación de 6 dígitos a tu casilla de correo.</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 small" role="alert">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        </div>
                    }

                    <form asp-action="VerifyCode" asp-controller="Logins" method="post">

                        <input type="hidden" name="username" value="@ViewBag.UserName" />

                        <div class="mb-4">
                            <label class="form-label text-secondary small fw-bold text-uppercase">Código de Verificación</label>
                            <input type="text"
                                   name="code"
                                   class="form-control form-control-lg text-center fw-bold text-success tracking-widest"
                                   placeholder="000000"
                                   required
                                   maxlength="6"
                                   autocomplete="off"
                                   style="letter-spacing: 4px; font-size: 24px;" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold fs-6">
                                Validar y Activar Cuenta
                            </button>
                        </div>

                    </form>

                    <div class="text-center mt-4">
                        <a asp-action="Login" asp-controller="Logins" class="text-decoration-none small text-muted">
                            <i class="bi bi-arrow-left"></i> Volver al inicio de sesión
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>