@model PriceOfShopEditVm

@{
    ViewData["Title"] = Model.Id == 0 ? "Crear Precio" : "Editar Precio";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4>@ViewData["Title"]</h4>
        </div>

        <div class="card-body">
            <form asp-action="Upsert" method="post">
                <input type="hidden" asp-for="Id" />

                <!-- PRODUCTO -->
                <div class="mb-3">
                    <label class="form-label">Producto</label>

                    <!-- botón abre modal -->
                    <button type="button" class="btn btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#productModal">
                        Select Product
                    </button>

                    <!-- producto seleccionado -->
                    <input type="hidden" asp-for="ProductId" id="ProductId"/>
                    <div id="selectedProduct" class="mt-3">
                        @if (Model.ProductName != null)
                        {
                            <span>@Model.ProductName</span>
                        }
                    </div>
                </div>

                <!-- TIENDA -->
                <div class="mb-3">
                    <label class="form-label">Tienda</label>
                    <select asp-for="ShopId" asp-items="Model.Shops" class="form-select">
                        <option value="">-- Select Shop --</option>
                    </select>
                    <span asp-validation-for="ShopId" class="text-danger"></span>
                </div>

                <!-- PRECIO -->
                <div class="mb-3">
                    <label class="form-label">Precio</label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <!-- BOTONES -->
                <div class="d-flex justify-content-center">
                    @if (Model.Id == 0)
                    {
                        <button class="btn btn-primary mt-2" type="submit">
                            <i class="bi bi-floppy2-fill"></i>
                            Save
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-warning mt-2" type="submit">
                            <i class="bi bi-floppy2-fill"></i>
                            Update
                        </button>
                    }
                    <a class="btn btn-success ms-3 mt-2 " asp-controller="PricesOfShops" asp-action="Index">
                        <i class="bi bi-backspace"></i>
                        Back to List
                    </a>

                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL PRODUCTOS -->
<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Seleccionar producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    @foreach (var product in Model.ProductLists!) 
                    {
                        <div class="col-md-3 mb-3">
                            <div class="card product-card h-100"
                                 onclick="selectProduct(@product.Id, '@Html.Raw(product.Name.Replace("'", "\\'"))', '@product.Image')"
                                 style="cursor:pointer;">

                                <img src="@product.Image" class="card-img-top p-2" style="height:150px; object-fit:contain;" />

                                <div class="card-body text-center">
                                    <h6>@product.Name</h6>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


