@model CityEditVm

<form method="post">
	@Html.AntiForgeryToken()
	<input type="hidden" asp-for="Id" />
	<div class=" border p-3 m-4 w-75 mx-auto">
		<div class="row pb-2">
			<h2 class="text-primary">@(Model.Id == 0 ? "Add City" : "Update City")</h2>
			<hr />
		</div>
		<div asp-validation-summary="ModelOnly" class="text-danger"></div>
		<div class=" mb-3 row p-1">
			<label class="p-0" asp-for="CityName"></label>
			<input class="form-control" asp-for="CityName" />
			<span class="text-danger" asp-validation-for="CityName"></span>
		</div>
		<div class="mb-3 row p-1">
			<label class="p-0" asp-for="ProvinceId"></label>
			<select class="form-control" asp-for="ProvinceId" asp-items="@Model.Provinces">
				<option selected disabled="">-- Select Province --</option>
			</select>
			<span class="text-danger" asp-validation-for="ProvinceId"></span>
		</div>
		@if (Model.Id == 0)
		{
			<button class="btn btn-primary" type="submit">
				<i class="bi bi-floppy2-fill"></i>
				Save
			</button>
		}
		else
		{
			<button class="btn btn-warning" type="submit">
				<i class="bi bi-floppy2-fill"></i>
				Update
			</button>
		}

		<a class="btn btn-success" asp-controller="Cities" asp-action="Index">
			<i class="bi bi-backspace"></i>
			Back to List
		</a>
	</div>
</form>
