<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AhorraYa.Client</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
    <link rel="stylesheet" asp-href-include="AhorraYa.Client.styles.css" asp-append-version="true" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        @{
            var user = Context.Session.GetString("UserName");
            var role = Context.Session.GetString("Role");
        }
        @if(role is null)
        {
            
        }
        else
        {
            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3 border-bottom border-light">
                <div class="container">
                    <a class="navbar-brand fs-4 fw-bold text-primary d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-piggy-bank-fill me-2 text-success"></i>Ahorra<span class="text-dark">Ya</span>
                    </a>

                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <div class="d-lg-flex justify-content-between align-items-center w-100">

                            <ul class="navbar-nav mb-2 mb-lg-0 gap-2">
                                <li class="nav-item">
                                    <a class="nav-link px-3 rounded-pill fw-medium d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-house-door me-1"></i> Inicio
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 rounded-pill fw-medium d-flex align-items-center" asp-area="" asp-controller="PricesOfShops" asp-action="Index">
                                        <i class="bi bi-shop me-1"></i> Explorar Precios
                                    </a>
                                </li>

                                @if (role == "Admin")
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle px-3 rounded-pill fw-bold text-success d-flex align-items-center" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-gear-fill me-1"></i> Panel Admin
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-start shadow border-0 mt-2" aria-labelledby="adminDropdown">
                                            <li class="dropdown-header text-uppercase fs-7 fw-bold text-muted">Gestión Base</li>
                                            <li><a class="dropdown-item py-2" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam me-2"></i> Products</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Brands" asp-action="Index"><i class="bi bi-tag me-2"></i> Brands</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Categories" asp-action="Index"><i class="bi bi-grid me-2"></i> Categories</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li class="dropdown-header text-uppercase fs-7 fw-bold text-muted">Logística</li>
                                            <li><a class="dropdown-item py-2" asp-controller="Shops" asp-action="Index"><i class="bi bi-building me-2"></i> Shops</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Locations" asp-action="Index"><i class="bi bi-geo-alt me-2"></i> Locations</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Cities" asp-action="Index"><i class="bi bi-map me-2"></i> Cities</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Provinces" asp-action="Index"><i class="bi bi-globe me-2"></i> Provinces</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Countries" asp-action="Index"><i class="bi bi-flag me-2"></i> Countries</a></li>
                                        </ul>
                                    </li>
                                }

                                <li class="nav-item">
                                    <a class="nav-link px-3 rounded-pill fw-medium d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Privacy">
                                        <i class="bi bi-shield-lock me-1"></i> Privacy
                                    </a>
                                </li>
                            </ul>

                            <div class="d-flex align-items-center mt-2 mt-lg-0">
                                @if (!string.IsNullOrEmpty(user))
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-light dropdown-toggle border fw-medium px-3 rounded-pill d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-person-circle me-2 text-primary"></i> @user
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                            <li>
                                                <a class="dropdown-item py-2 text-danger" asp-controller="Logins" asp-action="Logout">
                                                    <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <a class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm" asp-controller="Logins" asp-action="Login">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                    </a>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            </nav>
        }
    </header>
    <div class="container">
        <main role="main" class="container flex-grow-1 pb-3 pb-5">
            
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto">
        <div class="container">
            &copy; 2026 - AhorraYa.Client - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
